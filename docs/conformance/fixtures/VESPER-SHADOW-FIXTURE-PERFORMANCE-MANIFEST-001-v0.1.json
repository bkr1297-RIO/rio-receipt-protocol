  "performance_manifest": {
    "status": "MEASUREMENT_PROTOCOL_ONLY_NO_RESULTS_RECORDED",
    "claim_boundary": "This manifest defines how to measure the declared shadow profile. It contains no latency, throughput, availability, or production performance claim.",
    "measurement_scope": {
      "included": [
        "grant_parse_and_schema_validation",
        "registered_key_resolution_and_signature_verification",
        "target_and_canonical_header_verification",
        "raw_byte_payload_hash_verification",
        "durable_reservation",
        "pre_dispatch_record_persistence",
        "zero_egress_simulation",
        "execution_receipt_persistence",
        "remainder_and_settlement_record_persistence"
      ],
      "excluded": [
        "live_network_latency",
        "GitHub_API_latency",
        "human_review_time",
        "third_party_service_availability",
        "production_key_management_latency",
        "multi-node_replication_latency"
      ]
    },
    "run_protocol": {
      "clock": "monotonic_high_resolution",
      "warmup_runs": 20,
      "measured_runs": 100,
      "concurrency": 1,
      "environment_fingerprint_required": ["runtime_version", "host_os", "cpu_architecture", "durable_store_kind", "no_egress_enforcement_kind"],
      "report_metrics": ["count", "min_ms", "p50_ms", "p95_ms", "p99_ms", "max_ms", "mean_ms", "failure_count"],
      "report_phases_separately": true,
      "fixture_required": "VSF-001-HAPPY-SHADOW-ROUTE"
    },
    "result_contract": {
      "required_fields": ["implementation_ref", "run_id", "executed_at", "environment_fingerprint", "fixture_id", "metrics", "pass_fail", "evidence_refs"],
      "prohibited_interpretations": [
        "production_readiness",
        "live_GitHub_performance",
        "end_to_end_external_effect_latency",
        "general-purpose_connector_performance"
      ]
    }
  },
  "conformance_verdict_rules": {
    "PASS": "Every required fixture reaches its exact expected terminal state; required records resolve in one lineage; the positive fixture has environment-enforced no-egress evidence; and no prohibited operation occurred.",
    "FAIL": "Any expected state, record, hash, authority boundary, replay rule, or zero-egress proof fails; any prohibited operation is attempted; or any successful outcome is claimed without required evidence.",
    "INCONCLUSIVE": "A fixture cannot provide enough evidence to evaluate a declared requirement. INCONCLUSIVE is not PASS and cannot support a performance or runtime claim."
  },
  "evidence_limited_claim": "A PASS supports only the claim that the identified implementation version exercised the declared synthetic fixtures against one registered shadow connector with enforced zero egress. It does not authorize execution, prove live GitHub behavior, or establish production performance."
}
