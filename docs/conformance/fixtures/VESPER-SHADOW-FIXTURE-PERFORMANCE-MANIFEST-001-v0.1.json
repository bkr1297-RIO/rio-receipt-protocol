      "payload_hash": "sha256:c4d50150c7260c18adc9a1f18f7607c09398583728739454d959fbf163ce647b",
      "headers": {
        "content-type": "application/json",
        "idempotency-key": "fixture-nonce-vesper-shadow-001"
