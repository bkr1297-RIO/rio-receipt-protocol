        "sentinel_verdict": "DENY_UNAUTHORIZED_PROMOTION",
        "terminal_state": "DENIED",
        "execution_count": 0
      }
    },
    {
      "fixture_id": "VSF-007-ABANDONED-BRANCH-CANNOT-DISPATCH",
      "kind": "negative",
      "branch_lineage": {"relationship": "ABANDONED", "dispatchable": false},
      "expected": {
        "sentinel_verdict": "DENY_BRANCH_NOT_SELECTABLE",
        "terminal_state": "DENIED",
        "execution_count": 0
