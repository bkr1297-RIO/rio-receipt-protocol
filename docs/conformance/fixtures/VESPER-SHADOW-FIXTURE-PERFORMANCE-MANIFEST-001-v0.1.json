    },
    {
      "fixture_id": "VSF-005-NO-EGRESS-PROOF-UNAVAILABLE",
      "kind": "fault",
      "injected_fault": "environment_no_egress_evidence_unavailable",
      "expected": {
        "terminal_state": "OUTCOME_UNKNOWN",
        "success_claim_permitted": false,
        "remainder_nonempty": true,
        "automatic_retry_count": 0
      }
    },
    {
      "fixture_id": "VSF-006-RETURN-CANNOT-REAUTHORIZE",
      "kind": "negative",
      "mutation": {"attempt": "reuse_returned_unpromoted_orientation_as_authority"},
