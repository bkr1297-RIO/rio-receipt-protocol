      "mutation": {"issuer_key_status": "REVOKED_BEFORE_VERIFICATION"},
      "expected": {
        "sentinel_verdict": "DENY_REVOKED_ISSUER",
        "terminal_state": "REVOKED",
        "execution_count": 0
      }
    },
    {
      "fixture_id": "VSF-004-POST-RESERVATION-NO-DISPATCH",
      "kind": "fault",
      "injected_fault": "capability_release_failure_after_durable_reservation",
      "expected": {
        "terminal_state": "SETTLED_NO_DISPATCH",
        "execution_count": 0,
        "automatic_retry_count": 0,
