  "required_success_state_sequence": [
    "FORMED",
    "ROUTED",
    "REVIEWED",
    "AUTHORITY_BOUND",
    "RESERVED",
    "PRE_DISPATCH_RECORDED",
    "SIMULATED_NO_EGRESS",
    "RECEIPTED",
    "REMAINDER_OPEN",
    "SETTLED",
    "RETURNED_UNPROMOTED"
  ],
  "required_records": [
    {
      "type": "MetroEnvelope",
      "before_state": "ROUTED",
      "must_bind": ["route_id", "object_id", "scope", "expiry", "provenance"]
    },
    {
      "type": "AuthorizationGrant",
      "before_state": "AUTHORITY_BOUND",
      "must_bind": ["target_ref", "method", "path_and_query", "canonical_headers_hash", "payload_hash", "nonce", "audience", "expiry"]
    },
    {
      "type": "PreDispatchCrossingRecord",
      "before_state": "PRE_DISPATCH_RECORDED",
      "must_bind": ["grant_hash", "reservation_ref", "payload_hash", "target_ref", "sentinel_verdict"],
      "durable": true,
      "signed": true
    },
    {
      "type": "ExecutionReceipt",
      "before_state": "RECEIPTED",
      "must_bind": ["pre_dispatch_record_hash", "terminal_outcome", "no_egress_evidence_ref", "effect_hash"],
      "durable": true,
      "signed": true
    },
    {
      "type": "RemainderAccount",
      "before_state": "REMAINDER_OPEN",
      "must_bind": ["unexecuted_live_effect", "non_exportable_authority", "unpromoted_return"]
    },
    {
      "type": "SettlementRecord",
      "before_state": "SETTLED",
      "must_bind": ["settled_scope", "unsettled_scope", "remainder_disposition"]
    }
  ],
  "fixtures": [
    {
      "fixture_id": "VSF-001-HAPPY-SHADOW-ROUTE",
      "kind": "positive",
      "input_variant": "canonical_material",
      "expected": {
        "sentinel_verdict": "ALLOW_SHADOW_ONLY",
        "terminal_state": "RETURNED_UNPROMOTED",
        "required_state_sequence": "required_success_state_sequence",
        "execution_state": "SIMULATED_NO_EGRESS",
        "no_egress_proof_required": true,
        "remainder_nonempty": true,
        "orientation_status": "UNPROMOTED"
      }
    },
    {
      "fixture_id": "VSF-002-ONE-BYTE-PAYLOAD-MISMATCH",
      "kind": "negative",
      "mutation": {"byte_offset": 0, "operation": "flip_bit"},
      "expected": {
        "sentinel_verdict": "DENY_PAYLOAD_MISMATCH",
        "terminal_state": "DENIED",
        "forbidden_states": ["RESERVED", "PRE_DISPATCH_RECORDED", "SIMULATED_NO_EGRESS"],
        "execution_count": 0
      }
    },
    {
      "fixture_id": "VSF-003-REVOKED-ISSUER",
